{
  "name": "Created task echoes the body",
  "route": "POST /tasks",
  "priority": 50,
  "then": {
    "status": 201,
    "headers": {
      "location": "/tasks/7"
    },
    "body": {
      "id": 7,
      "title": "{{request.body.title}}",
      "assignee": "{{request.body.assignee}}",
      "status": "todo",
      "createdAt": "{{now}}"
    }
  }
}
