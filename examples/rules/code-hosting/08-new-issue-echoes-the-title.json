{
  "name": "New issue echoes the title",
  "route": "POST /repos/{owner}/{repo}/issues",
  "priority": 50,
  "then": {
    "status": 201,
    "body": {
      "number": 101,
      "title": "{{request.body.title}}",
      "state": "open",
      "author": {
        "id": 1,
        "login": "{{faker.user_name}}"
      },
      "createdAt": "{{now}}"
    }
  }
}
