{
  "name": "Large charges go to review",
  "route": "POST /charges",
  "priority": 30,
  "when": {
    "all": [
      {
        "source": "body",
        "field": "$.amount",
        "op": "gt",
        "value": 1000000
      }
    ]
  },
  "then": {
    "status": 201,
    "body": {
      "id": "ch_review0000",
      "amount": "{{request.body.amount}}",
      "currency": "{{request.body.currency}}",
      "status": "pending"
    }
  }
}
